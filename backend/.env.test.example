# Copy to .env.test. Point this at a disposable database — the test
# suite truncates every table between tests, so never use your dev or
# prod DATABASE_URL here. Easiest option: the `postgres` service from
# docker-compose.yml, with a different database name.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_tracker_test
JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-production
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
