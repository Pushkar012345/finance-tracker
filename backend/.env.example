# Copy to backend/.env for running WITHOUT Docker (npm run dev).
# With `docker compose up` you don't need this file.

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker
# Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Optional (defaults shown) ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI categorization, chat assistant, receipt scanning, monthly reports
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Receipt image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Budget-alert emails (in-app notifications work without these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finance Tracker <notifications@financetracker.app>"
