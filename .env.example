# Optional overrides for `docker compose up`. Copy to `.env` (same folder as
# docker-compose.yml). Everything has a safe local default, so this file is
# only needed if you want to change something.

# Generate real secrets with:  openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_tracker

# Optional features (the app boots fine without them)
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
